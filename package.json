{
  "name": "hospital-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital Management System - Monorepo (NestJS Backend + Vite React Monochromatic Frontend)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"white.bold,gray.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:push": "npm run prisma:push --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "mongo:start": "mongod --config mongod.conf",
    "mongo:stop": "mongod --config mongod.conf --shutdown",
    "mongo:status": "mongosh --eval 'rs.status().ok'"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
