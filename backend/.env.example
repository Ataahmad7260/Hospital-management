# Environment configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String with Prisma (Local Replica Set or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/hospital_management?replicaSet=rs0
# Atlas: mongodb+srv://<username>:<password>@<cluster-domain>/hospital_management?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/hospital_management?authSource=admin"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Swagger Documentation
SWAGGER_PATH="api/docs"
