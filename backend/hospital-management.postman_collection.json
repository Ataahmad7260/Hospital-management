              "path": [
                "appointments"
              ]
            },
            "description": "Lists appointments automatically scoped by caller's role."
          }
        },
        {
          "name": "Book Appointment (Role: ADMIN, PATIENT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.environment.set('targetAppointmentId', json.data.id);",
                  "        console.log('✅ Created Appointment ID: ' + json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{targetDoctorProfileId}}\",\n  \"patientId\": \"{{targetPatientProfileId}}\",\n  \"appointmentDate\": \"2026-11-20T10:00:00.000Z\",\n  \"timeSlot\": \"10:00 - 10:30 AM\",\n  \"reason\": \"Routine cardiovascular checkup and blood pressure review\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "description": "Books a consultation appointment between a patient and a doctor."
          }
        },
        {
          "name": "Update Appointment Status (Role: ADMIN, DOCTOR)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{targetAppointmentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{targetAppointmentId}}",
                "status"
              ]
            },
            "description": "Status options: SCHEDULED, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED"
          }
        }
      ]
    },
    {
